{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "templates",
    "batches",
    "ledger",
    "selected",
    "metrics",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol": {
      "const": "abl1_fragment_generation_v1"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "template_id",
          "safe_input",
          "seed",
          "reconstruction_safe",
          "retained_fragment_with_dummy"
        ]
      }
    },
    "batches": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "batch_index",
          "execution_mode",
          "response_sha256",
          "returned_count"
        ]
      }
    },
    "ledger": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "proposal_id",
          "status",
          "template_id"
        ]
      }
    },
    "selected": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "returned_count",
        "accepted_unique_count",
        "selected_count",
        "valid_structure_count",
        "diversity_pair_count",
        "synthesis_feasibility"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    }
  }
}
