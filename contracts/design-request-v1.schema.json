{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToxOracle advanced ABL1 request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "mode",
    "target",
    "input_provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "enum": [
        "screen",
        "generate_screen"
      ]
    },
    "target": {
      "enum": [
        "ABL1",
        "human_abl1_2hyy_A"
      ]
    },
    "input_provenance": {
      "enum": [
        "public",
        "locally_reviewed_and_approved"
      ]
    },
    "compounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "compound_id"
        ],
        "properties": {
          "compound_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "canonical_smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "atom_mapped_smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "structure_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "standardization_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "oneOf": [
          {
            "required": [
              "smiles"
            ],
            "not": {
              "required": [
                "canonical_smiles"
              ]
            }
          },
          {
            "required": [
              "canonical_smiles"
            ],
            "not": {
              "required": [
                "smiles"
              ]
            }
          }
        ]
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "compound_id"
        ],
        "properties": {
          "compound_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "canonical_smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "atom_mapped_smiles": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "structure_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "standardization_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "oneOf": [
          {
            "required": [
              "smiles"
            ],
            "not": {
              "required": [
                "canonical_smiles"
              ]
            }
          },
          {
            "required": [
              "canonical_smiles"
            ],
            "not": {
              "required": [
                "smiles"
              ]
            }
          }
        ]
      }
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "screen"
          }
        }
      },
      "then": {
        "required": [
          "compounds"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "seeds"
              ]
            },
            {
              "required": [
                "count"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "compounds"
          ]
        }
      }
    }
  ]
}
