{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toxoracle.example/schemas/response.schema.json",
  "title": "ToxOracle v2 assessment response",
  "description": "Shared response envelope emitted by either the discovery or toxicity stream.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "stream",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "enum": [
        "discovery",
        "toxicity"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringReference": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound_id",
        "structure_id",
        "status",
        "assessment",
        "structural_evidence",
        "supplementary_metrics",
        "provenance",
        "warnings",
        "error"
      ],
      "properties": {
        "compound_id": {
          "type": "string",
          "minLength": 1
        },
        "structure_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "invalid_input",
            "unsupported",
            "failed",
            "not_run"
          ]
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "structural_evidence": {
          "$ref": "#/$defs/structuralEvidence"
        },
        "supplementary_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementaryMetric"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "invalid_input",
                  "unsupported",
                  "failed",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "assessment": {
                "properties": {
                  "risk_score": {
                    "type": "null"
                  },
                  "call": {
                    "const": "unavailable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "positive_definition",
        "negative_definition",
        "context",
        "evidence_type",
        "risk_score",
        "score_kind",
        "direction",
        "threshold",
        "call",
        "calibration",
        "uncertainty",
        "applicability"
      ],
      "properties": {
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "positive_definition": {
          "type": "string",
          "minLength": 1
        },
        "negative_definition": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "evidence_type": {
          "enum": [
            "model_prediction",
            "measured_assay"
          ]
        },
        "risk_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "score_kind": {
          "enum": [
            "calibrated_probability",
            "uncalibrated_score",
            "unavailable"
          ]
        },
        "direction": {
          "enum": [
            "higher_is_more_toxic",
            "lower_is_more_toxic",
            "unavailable"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "call": {
          "enum": [
            "positive",
            "negative",
            "unavailable"
          ]
        },
        "calibration": {
          "$ref": "#/$defs/calibration"
        },
        "uncertainty": {
          "$ref": "#/$defs/methodValue"
        },
        "applicability": {
          "$ref": "#/$defs/methodValue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score_kind": {
                "const": "unavailable"
              }
            },
            "required": [
              "score_kind"
            ]
          },
          "then": {
            "properties": {
              "risk_score": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_kind": {
                "const": "calibrated_probability"
              }
            },
            "required": [
              "score_kind"
            ]
          },
          "then": {
            "properties": {
              "calibration": {
                "properties": {
                  "status": {
                    "const": "assessed"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species",
        "system",
        "conditions"
      ],
      "properties": {
        "species": {
          "$ref": "#/$defs/nullableString"
        },
        "system": {
          "$ref": "#/$defs/nullableString"
        },
        "conditions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "assessed",
            "not_assessed",
            "not_applicable",
            "unknown"
          ]
        },
        "reference": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "methodValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "structuralEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_smiles",
        "atom_mapped_smiles",
        "standardization_version",
        "attribution_status",
        "attribution_method",
        "attribution_target",
        "attribution_scale",
        "attribution_reference",
        "fragments",
        "structure_artifacts",
        "interactions",
        "mechanism_hypotheses"
      ],
      "properties": {
        "canonical_smiles": {
          "type": "string",
          "minLength": 1
        },
        "atom_mapped_smiles": {
          "type": "string",
          "minLength": 1
        },
        "standardization_version": {
          "type": "string",
          "minLength": 1
        },
        "attribution_status": {
          "enum": [
            "available",
            "unavailable",
            "partial"
          ]
        },
        "attribution_method": {
          "$ref": "#/$defs/nullableString"
        },
        "attribution_target": {
          "$ref": "#/$defs/nullableString"
        },
        "attribution_scale": {
          "$ref": "#/$defs/nullableString"
        },
        "attribution_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fragment"
          }
        },
        "structure_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structureArtifact"
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "mechanism_hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanismHypothesis"
          }
        }
      }
    },
    "atomMapIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "atom_map_ids",
        "pattern",
        "contribution",
        "evidence_kind",
        "source_ref",
        "mapping_ambiguous"
      ],
      "properties": {
        "fragment_id": {
          "type": "string",
          "minLength": 1
        },
        "atom_map_ids": {
          "$ref": "#/$defs/atomMapIds"
        },
        "pattern": {
          "$ref": "#/$defs/nullableString"
        },
        "contribution": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "$ref": "#/$defs/stringReference"
        },
        "mapping_ambiguous": {
          "type": "boolean"
        }
      }
    },
    "structureArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "format",
        "uri",
        "checksum",
        "origin",
        "atom_mapping_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "experimental",
            "predicted",
            "generated"
          ]
        },
        "atom_mapping_ref": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "$ref": "#/$defs/nullableString"
        },
        "target_id": {
          "$ref": "#/$defs/nullableString"
        },
        "conformer_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_map_ids",
        "target_id",
        "chain_id",
        "residue_id",
        "interaction_type",
        "distance_angstrom",
        "artifact_ref"
      ],
      "properties": {
        "atom_map_ids": {
          "$ref": "#/$defs/atomMapIds"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "chain_id": {
          "type": "string",
          "minLength": 1
        },
        "residue_id": {
          "type": "string",
          "minLength": 1
        },
        "interaction_type": {
          "type": "string",
          "minLength": 1
        },
        "distance_angstrom": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "artifact_ref": {
          "$ref": "#/$defs/stringReference"
        }
      }
    },
    "mechanismHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "evidence_refs",
        "evidence_level",
        "proposed_validation"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stringReference"
          }
        },
        "evidence_level": {
          "type": "string",
          "minLength": 1
        },
        "proposed_validation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supplementaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "direction",
        "meaning",
        "source_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/nullableString"
        },
        "direction": {
          "$ref": "#/$defs/nullableString"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "$ref": "#/$defs/stringReference"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method_id",
        "model_origin",
        "data_version",
        "training_membership",
        "evidence_refs"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "model_origin": {
          "type": "string",
          "minLength": 1
        },
        "data_version": {
          "$ref": "#/$defs/nullableString"
        },
        "training_membership": {
          "enum": [
            "included",
            "excluded",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stringReference"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
