#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
screen_python="${TOXORACLE_PYTHON:-$project_root/toxicity/.venv/bin/python}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$project_root/app/src:$project_root/discovery/src:$project_root${PYTHONPATH:+:$PYTHONPATH}"
exec "$screen_python" -m toxoracle_app.screen_cli "$@"
